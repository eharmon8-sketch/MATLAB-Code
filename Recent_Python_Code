def calculate_transmission(I0, attenuation_length, thickness):
    """
    Calculates the transmitted intensity with the following parameters:

    I0 (float): Initial intensity (eV)
    attenuation_length (float): Lambda value (microns)
    thickness (float): Thickness of the material 'x' (microns)

    Returns:
    float: Transmitted intensity (eV)
    """
    # a = 1 / lambda
    alpha = 1.0 / attenuation_length

    # I = I0 * e^-(a*x)
    transmitted_intensity = I0 * math.exp(-alpha * thickness)

    return transmitted_intensity

