def align_cross_correlation(ref_img, target_img, upsample_factor=100):
    shifts, error, phasediff = phase_cross_correlation(
        ref_img,
        target_img,
        upsample_factor=upsample_factor,
    )
    y_shift, x_shift = shifts

    translation_matrix = np.float32([[1, 0, -x_shift], [0, 1, -y_shift]])
    rows, cols = target_img.shape
    corrected_image = cv2.warpAffine(
        target_img,
        translation_matrix,
        (cols, rows),
        flags=cv2.INTER_LANCZOS4,
    )

    print('\nCross-Correlation Assignment')
    print(f'Comparing Stack Index {Target_index} against Reference Stack Index {Ref_index}')
    print(f'Detected Drift Vector X: {x_shift:.3f} pixels, Detected Drift Vector Y: {y_shift:.3f} pixels\n')

    return corrected_image

