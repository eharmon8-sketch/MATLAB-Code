%% Implementing the Equations from Pagnin's Textbook for Simple PCI
close all;
clear;
clc;

%% Sample Matrix
% The sample is a 400 x 20 matrix where the left half of the matrix is made
% of water and the right half of the matrix is made of calcium.
% for a wavelength of ~0.3 um

lambda = 0.3e-6;   % m UV
lambda = 0.1e-9; % m X-Rays
K = (2*pi)/lambda;

N_1 = 1.369839 - 1i*(3.826e-09); % complex refractive index of water
N_2 = 0.67852  - 1i*(0.86244);   % complex refractive index of calcium
%N_1 = 1;                          % complex refractive index of air
%N_2 = 1.369839 - 1i*(3.826e-09);  % complex refractive index of water
N_1 = 1 - 8e-8  + 1i*2e-11;    % air
N_2 = 1 - 3.5e-6 + 1i*1.7e-8;  % water

% Set each initial component of the K vector
KX = 0;
KY = 0;
KZ = K;

% Start with a scalar field that is constant PSI = 1 everywhere
PSI_1 = ones(20,200);
PSI_2 = ones(20,200);

%% X-Ray interaction with matter
% For a sample z1 = 0.1 m thick
z1 = 1e-3;

PSI_disturbed_1 = exp(1i*K*z1*N_1) * PSI_1;
PSI_disturbed_2 = exp(1i*K*z1*N_2) * PSI_2;

% Image just after leaving the sample
I1 = abs(PSI_disturbed_1).^2;
I2 = abs(PSI_disturbed_2).^2;

PSI_disturbed = [I1 I2]; % amalgation

figure(1);
imagesc(PSI_disturbed);
colorbar;
colormap(flipud(gray));
clim([0 2]);
title('Intensity image of scalar field immediately after exiting A/W sample');

%% The Free Space Propagator
z2 = 0.5;  % propagation distance in meters

P = exp(1i * z2 * sqrt(K.^2 - KX.^2 - KY.^2));

%% Using the propagator
P_A = fft2(PSI_disturbed);

figure(2);
imagesc(abs(P_A).^2);
colorbar;
colormap(flipud(gray));
title('FFT of Matrix After Sample');

P_B = P_A .* P;

figure(3);
imagesc(abs(P_B).^2);
colorbar;
colormap(flipud(gray));
title('FFT x Free Space Propagator');

P_C = ifft2(P_B);

% Image After Propagating
Final = abs(P_C).^2;

figure(4);
imagesc(Final);

colorbar;
colormap(flipud(gray));
title('Intensity Image of Scalar Field after Propagating 0.5 m');
