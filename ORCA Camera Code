# Camera and optical information for an ORCA-Flash4.0 LT3 Digital CMOS camera
# Using a MAP 1030100 lens
f_number_lens1 = 0.030 / 0.035 # m
f_number_lens2 = 0.100 / 0.035 # m
flange_focal_distance = 0.017526 # m
lens_focal_distance = 0.05 # m

pixel_size = 6.5e-6 # m.
pixel_area = pixel_size ** 2 # area of one pixel, m ** 2
detector_horizontal = 2048 # horizontal pixels
detector_vertical = 2048 # vertical pixels
well_depth = 30000 # per pixel
quantum_efficiency = 0.82 # achieved at a wavelength of 560 nm
number_bits = 16
total_counts = 2 ** number_bits
total_pixels = detector_vertical * detector_horizontal # = pHorizontal * pVertical; number of pixels
detector_area = pixel_area * total_pixels # actual area of sensor


# Geometry and distances
distance_IP_window = 4.8 # m
